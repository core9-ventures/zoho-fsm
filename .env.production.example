# Copy to ".env" on the VPS (never commit it). Docker Compose reads it for both the stack and the app.
APP_DOMAIN=app.yourdomain.com

# Database passwords (letters and digits only, so they are safe inside the URLs below)
DB_OWNER_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
DATABASE_URL=postgresql://fieldserve_app:change-me-app@db:5432/fieldserve?schema=public
DIRECT_DATABASE_URL=postgresql://fieldserve:change-me-owner@db:5432/fieldserve?schema=public

# openssl rand -base64 32  (use two different values)
AUTH_SECRET=
JWT_SECRET=
AUTH_TRUST_HOST=true
NODE_ENV=production

UPLOAD_DIR=/data/uploads
LOG_LEVEL=info

# First deploy only: creates the Super Admin (password at least 12 characters)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin
